# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jewellery_db

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email (SMTP) — required for OTP delivery
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# File Storage
# Set to 'local' for local storage, 's3' for AWS S3, 'cloudinary' for Cloudinary
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# AWS S3 (only if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# Cloudinary (only if STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional, for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Admin default (only used for initial seed — change immediately)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
